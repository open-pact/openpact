# OpenPact environment variables
# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# LLM provider credentials (OpenAI, Gemini, Copilot, Ollama) are NOT set
# via env vars any more — sign in through the admin UI at /engine. The
# credentials are written to <workspace>/secure/data/stackllm_auth.json.

# Discord bot token. You can also set this via the admin UI.
DISCORD_TOKEN=

# Optional — GitHub personal access token (enables GitHub MCP tools).
GITHUB_TOKEN=

# Optional — path to config file (default: <workspace>/secure/config.yaml).
#CONFIG_PATH=/workspace/secure/config.yaml

# Host path for the workspace directory (mounted as /workspace in Docker).
HOST_WORKSPACE_PATH=~/.config/openpact/workspace

# Optional — admin UI bind address (default from config.yaml).
#ADMIN_BIND=0.0.0.0:8888
